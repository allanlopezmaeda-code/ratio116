<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Sistema de Pedidos Cafetería</title>

<style>
body{
    font-family: Arial, sans-serif;
    background:#f4f4f4;
    margin:20px;
}

.panel{
    background:white;
    padding:20px;
    border-radius:10px;
    margin-bottom:20px;
    box-shadow:0 2px 5px rgba(0,0,0,.2);
}

.header{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

button{
    padding:10px 15px;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

.btn-primary{
    background:#2e7d32;
    color:white;
}

.btn-danger{
    background:#c62828;
    color:white;
}

.btn-export{
    background:#1565c0;
    color:white;
}

.fullscreen-btn{
    background:#444;
    color:white;
}

input, select{
    padding:10px;
    width:100%;
    margin-top:5px;
    margin-bottom:15px;
    border:1px solid #ccc;
    border-radius:5px;
}

.pedido{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:10px;
    border-bottom:1px solid #ddd;
}

.completado{
    text-decoration: line-through;
    color:gray;
}
</style>
</head>

<body>

<div id="pedidoPanel" class="panel">

    <div class="header">
        <h2>Nuevo Pedido</h2>
        <button class="fullscreen-btn" onclick="pantallaCompleta('pedidoPanel')">⛶</button>
    </div>

    <label>Seleccione producto</label>

    <select id="tipoProducto" onchange="mostrarOpciones()">
        <option value="">Seleccione</option>
        <option value="cafe">CAFÉ</option>
        <option value="matcha">MATCHA</option>
    </select>

    <div id="opciones"></div>

    <button class="btn-primary" onclick="realizarPedido()">
        REALIZAR PEDIDO
    </button>

</div>

<div id="colaPanel" class="panel">

    <div class="header">
        <h2>Cola de Pedidos</h2>
        <button class="fullscreen-btn" onclick="pantallaCompleta('colaPanel')">⛶</button>
    </div>

    <div id="listaPedidos"></div>

    <br>

    <button class="btn-export" onclick="exportarCSV()">
        Exportar a Excel
    </button>

    <button class="btn-danger" onclick="borrarPedidos()">
        Borrar Registros
    </button>

</div>

<script>

let pedidos = [];
let contador = 1;

function mostrarOpciones(){

    const tipo = document.getElementById("tipoProducto").value;
    const opciones = document.getElementById("opciones");

    if(tipo === "matcha"){

        opciones.innerHTML = `
            <label>Presentación</label>
            <select id="subtipo">
                <option>Matcha</option>
            </select>

            <label>Temperatura</label>
            <select id="temperatura">
                <option>Caliente</option>
                <option>Frío</option>
            </select>

            <label>Base</label>
            <select id="base">
                <option>Con Agua</option>
                <option>Con Leche</option>
            </select>
        `;
    }

    else if(tipo === "cafe"){

        opciones.innerHTML = `
            <label>Tipo de Café</label>
            <select id="subtipo">
                <option>Americano</option>
                <option>Latte</option>
                <option>Capuccino</option>
            </select>

            <label>Temperatura</label>
            <select id="temperatura">
                <option>Caliente</option>
                <option>Frío</option>
            </select>
        `;
    }

    else{
        opciones.innerHTML = "";
    }
}

function realizarPedido(){

    const tipo = document.getElementById("tipoProducto").value;

    if(!tipo){
        alert("Seleccione un producto");
        return;
    }

    const numeroPedido = contador++;

    const pedido = {
        numero: numeroPedido,
        producto: document.getElementById("subtipo").value,
        temperatura: document.getElementById("temperatura").value,
        base: document.getElementById("base")
            ? document.getElementById("base").value
            : "",
        completado:false
    };

    pedidos.push(pedido);

    alert("Pedido #" + numeroPedido + " registrado");

    renderPedidos();
}

function renderPedidos(){

    const lista = document.getElementById("listaPedidos");

    lista.innerHTML = "";

    pedidos.forEach((pedido,index)=>{

        lista.innerHTML += `
            <div class="pedido ${pedido.completado ? 'completado':''}">
                <div>
                    <strong>#${pedido.numero}</strong> -
                    ${pedido.producto}
                    ${pedido.temperatura}
                    ${pedido.base}
                </div>

                <input
                    type="checkbox"
                    ${pedido.completado ? 'checked':''}
                    onchange="togglePedido(${index})">
            </div>
        `;
    });
}

function togglePedido(index){

    pedidos[index].completado =
        !pedidos[index].completado;

    renderPedidos();
}

function exportarCSV(){

    let csv =
    "Pedido,Producto,Temperatura,Base,Estado\n";

    pedidos.forEach(p=>{

        csv += `${p.numero},
${p.producto},
${p.temperatura},
${p.base},
${p.completado ? "Completado":"Pendiente"}\n`;

    });

    const blob = new Blob([csv],{
        type:"text/csv"
    });

    const url =
    window.URL.createObjectURL(blob);

    const a =
    document.createElement("a");

    a.href = url;
    a.download = "pedidos.csv";
    a.click();
}

function borrarPedidos(){

    if(confirm("¿Seguro que desea borrar todos los registros?")){

        pedidos = [];
        renderPedidos();
    }
}

function pantallaCompleta(id){

    const elemento =
    document.getElementById(id);

    if(elemento.requestFullscreen){
        elemento.requestFullscreen();
    }
}
</script>

</body>
</html>
